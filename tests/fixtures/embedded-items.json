  "sluggifyItemName": [
    {
      "fn": "sluggifyItemName",
      "args": [
        {
          "system": {
            "slug": "existing-slug"
          },
          "name": "Long Sword"
        }
      ],
      "output": "existing-slug",
      "note": "existing system.slug wins over name"
    },
    {
      "fn": "sluggifyItemName",
      "args": [
        {
          "name": "Long Sword +1"
        }
      ],
      "output": "long-sword-1",
      "note": "no game.pf2e.sluggify under Node -> regex fallback"
    },
    {
      "fn": "sluggifyItemName",
      "args": [
        {
          "name": "Довгий меч"
        }
      ],
      "output": "довгий-меч",
      "note": "Cyrillic name: PB.1 fix - fallback now mirrors PF2E sluggify (Unicode-aware), so it produces a real slug instead of an empty string"
    },
    {
      "fn": "sluggifyItemName",
      "args": [
        {}
      ],
      "output": "",
      "note": "no name at all -> empty slug"
    },
    {
      "fn": "sluggifyItemName",
      "args": [
        null
      ],
      "output": "",
      "note": "null item -> empty slug"
    }
