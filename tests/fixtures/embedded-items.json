  "buildTextPatch": [
    {
      "fn": "buildTextPatch",
      "args": [
        {
          "name": "Old Name",
          "system": {
            "description": {
              "value": "Old desc"
            }
          }
        },
        {
          "name": "New Name",
          "system": {
            "description": {
              "value": "New desc"
            }
          }
        }
      ],
      "output": {
        "name": "New Name",
        "system": {
          "description": {
            "value": "New desc"
          }
        }
      },
      "note": "name + description both differ -> full patch"
    },
    {
      "fn": "buildTextPatch",
      "args": [
        {
          "name": "Same",
          "system": {
            "description": {
              "value": "Same desc"
            }
          }
        },
        {
          "name": "Same",
          "system": {
            "description": {
              "value": "Same desc"
            }
          }
        }
      ],
      "output": null,
      "note": "nothing differs -> null"
    },
    {
      "fn": "buildTextPatch",
      "args": [
        {
          "name": "Old Name",
          "system": {
            "description": {
              "value": "Old desc"
            }
          }
        },
        {
          "name": "New Name",
          "system": {
            "description": {
              "value": "New desc"
            }
          }
        },
        {
          "updateName": false
        }
      ],
      "output": {
        "system": {
          "description": {
            "value": "New desc"
          }
        }
      },
      "note": "updateName:false -> name omitted from patch even though it differs"
    },
    {
      "fn": "buildTextPatch",
      "args": [
        {
          "name": "X",
          "system": {
            "description": {
              "value": "d",
              "gm": "old gm"
            }
          }
        },
        {
          "name": "X",
          "system": {
            "description": {
              "value": "d",
              "gm": "new gm"
            }
          }
        },
        {
          "updateGmDescription": true
        }
      ],
      "output": {
        "system": {
          "description": {
            "gm": "new gm"
          }
        }
      },
      "note": "updateGmDescription:true -> gm diff included"
    }
  ],
